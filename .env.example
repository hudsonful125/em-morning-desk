# Copy this file to a new file named ".env" (no ".example") and paste in your keys.
# The .env file is private: it is listed in .gitignore so it never gets uploaded.

# Phase 1: live exchange rates. Free key at https://twelvedata.com
TWELVE_DATA_KEY=paste-your-key-here

# Phase 2: news headlines. Free key at https://finnhub.io
FINNHUB_KEY=

# Phase 2: writes the brief. Key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Phase 6 (optional): email the morning brief through Gmail. Steps in modules/emailer.py
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
